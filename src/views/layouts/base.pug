include ../components/ticker.pug
include ../components/palette.pug
include ../components/flash.pug
include ../components/icons.pug
include ../components/news.pug

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    meta(name="description" content=description)
    link(rel="preload" href="/static/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="preload" href="/static/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="stylesheet" href="/static/css/app.css?v=" + assetVersion)
    script(src="/static/js/alpine-components.js?v=" + assetVersion defer)
    script(src="/static/js/alpine.js?v=" + assetVersion defer)
  body
    a.skip(href="#main") Skip to content
    header.rail
      .shell.rail-inner
        a.wordmark(href="/" aria-label="Meridian home")
          +icon("mark", 16)
          | MERIDIAN
        nav.nav(aria-label="Primary")
          a(href="/markets" aria-current=(path.startsWith("/markets") ? "page" : false)) Markets
          a(href="/get-started" aria-current=(path === "/get-started" ? "page" : false)) Get started
          a(href="/resources" aria-current=(path === "/resources" ? "page" : false)) Resources
          a(href="/fees" aria-current=(path === "/fees" ? "page" : false)) Fees
          a(href="/security" aria-current=(path === "/security" ? "page" : false)) Security
          a(href="/regulatory" aria-current=(path === "/regulatory" ? "page" : false)) Regulatory
          if user
            a(href="/dashboard") Dashboard
          else
            a.btn(href="/login") Sign in
      +ticker()
      +newsStrip(newsTicker)
    +palette(destinations)
    +shortcutSheet()
    main#main
      .shell
        +flashMessage(flash)
      block content
    footer.footer
      .shell
        .footer-cols
          .footer-brand
            .wordmark
              +icon("mark", 16)
              | MERIDIAN
            p Buy, sell, and store digital assets. Ten assets across five networks.
          div
            h2.footer-heading Product
            ul
              li: a(href="/markets") Markets
              li: a(href="/fees") Fees
              li: a(href="/status") Status
          div
            h2.footer-heading Company
            ul
              li: a(href="/about") About
              li: a(href="/security") Security
              li: a(href="/regulatory") Regulatory
          div
            h2.footer-heading Support
            ul
              li: a(href="/get-started") Get started
              li: a(href="/resources") Resources
              li: a(href="/help") Help centre
          div
            h2.footer-heading Legal
            ul
              li: a(href="/legal/terms") Terms of Service
              li: a(href="/legal/privacy") Privacy Policy
              li: a(href="/legal/risk") Risk Disclosure
              li: a(href="/legal/aml") AML Policy
              li: a(href="/legal/cookies") Cookie Policy
        .risk
          p
            strong Risk warning.
            |  Digital assets are volatile and you can lose the entire value of what you put in. Nothing on this site is investment advice, and nothing here is a promise of any return. Meridian does not guarantee the value of any asset.
          p Meridian is not yet licensed as a virtual asset service provider. Licence applications are in preparation. We are not accepting deposits or offering trading at this time.
