extends ../layouts/base.pug
include ../components/apptabs.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Deposit #{asset.displaySymbol}
          p.app-sub #{asset.networkLabel} · #{asset.confirmationsRequired} confirmations required
        +appTabs("deposit")

      .app-block
        .warn-note
          h2 Send only #{asset.displaySymbol} on #{asset.networkLabel}
          p Sending another asset, or this asset over a different network, results in permanent loss. Verify the network in your sending wallet before confirming.

      .app-block
        .deposit-grid
          .deposit-qr
            != qr
          .deposit-detail
            .tile-label Deposit address
            p.deposit-address.num= address
            if memo
              .tile-label Memo or tag, required
              p.deposit-address.num= memo
              p.field-hint Transfers sent without this memo cannot be credited.
            p.field-hint This address is permanent and accepts only #{asset.displaySymbol} on #{asset.networkLabel}.
            if !enabled
              p.field-hint Deposits are not enabled. Funds sent to this address will not be credited.

      if deposits.length
        .app-block
          .panel-table
            .panel-table-head
              h2 Recent #{asset.displaySymbol} deposits
            .table-scroll
              table.table
                thead
                  tr
                    th Transaction
                    th.n Confirmations
                    th.n Status
                tbody
                  each d in deposits
                    tr
                      td.num= d.txHash.slice(0, 22) + "…"
                      td.n.num #{d.confirmations} / #{asset.confirmationsRequired}
                      td.n= d.status
