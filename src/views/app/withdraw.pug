extends ../layouts/base.pug
include ../components/amount.pug
include ../components/apptabs.pug

include ../components/allowance.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Withdraw #{asset.displaySymbol}
          p.app-sub #{asset.networkLabel}
        +appTabs("withdraw")

      if error
        p.form-error= error

      +allowanceNote(allowance, tier)

      if !totpEnabled
        .app-block
          .warn-note
            h2 Two-factor authentication is off
            p Withdrawals work without it, but anyone with your password can move your funds. Turning it on adds a code to every withdrawal.
          .actions
            a.btn(href="/account/2fa") Turn on two-factor

      .app-block
        .tiles
          .tile
            .tile-label Available
            .tile-value
              +amount(available)
          .tile
            .tile-label On hold
            .tile-value
              +amount(held)
          .tile
            .tile-label Network fee
            .tile-value
              +amount(fee)
          .tile
            .tile-label Limit remaining
            .tile-value.num= allowance.remainingUsd === null ? "None" : "$" + allowance.remainingUsd.toLocaleString("en-US")

      .app-block
        .form-card
          h2 Send #{asset.displaySymbol}
          form(method="post" action="/wallet/withdraw/" + asset.symbol.toLowerCase())
            input(type="hidden" name="_csrf" value=csrfToken)
            .field
              label(for="destination") Destination address
              input#destination(type="text" name="destination" value=values.destination required autocomplete="off" spellcheck="false")
              p.field-hint Must be a #{asset.networkLabel} address. Sending to another network loses the funds.
            .field
              label(for="amount") Amount
              input#amount(type="text" name="amount" value=values.amount required inputmode="decimal" autocomplete="off")
              p.field-hint The network fee is taken on top of this amount.
            .field
              label(for="memo") Memo or tag (optional)
              input#memo(type="text" name="memo" value=values.memo autocomplete="off")
            if totpEnabled
              .field
                label(for="totp") Authentication code
                input#totp(type="text" name="totp" value="" required inputmode="numeric" autocomplete="one-time-code")
                p.field-hint From your authenticator app. Required for every withdrawal.
            button.btn.btn-primary(type="submit" disabled=!enabled) Request withdrawal
            if !enabled
              p.field-hint Withdrawals are not switched on yet.

      if withdrawals.length
        .app-block
          .panel-table
            .panel-table-head
              h2 Recent #{asset.displaySymbol} withdrawals
            .table-scroll
              table.table
                thead
                  tr
                    th Destination
                    th.n Amount
                    th.n Status
                tbody
                  each w in withdrawals
                    tr
                      td.num= w.destination.slice(0, 20) + "…"
                      td.n
                        +amount(w.amountParts)
                      td.n= w.status
