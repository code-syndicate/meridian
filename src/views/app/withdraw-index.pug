extends ../layouts/base.pug
include ../components/amount.pug
include ../components/apptabs.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Withdraw
          p.app-sub Choose the asset and network you are sending to
        +appTabs("withdraw")

      .app-block
        .panel-table
          .panel-table-head
            h2 Your balances
          .table-scroll
            table.table
              thead
                tr
                  th Asset
                  th Network
                  th.n Available
                  th.n: span.visually-hidden Action
              tbody
                each row in rows
                  tr
                    td
                      .asset-name
                        strong= row.name
                        span.asset-ticker= row.displaySymbol
                    td: span.network-tag= row.networkLabel
                    td.n
                      +amount(row.available)
                    td.n
                      a.btn(href="/wallet/withdraw/" + row.symbol.toLowerCase()) Withdraw
