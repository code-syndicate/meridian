extends ../layouts/base.pug
include ../components/amount.pug
include ../components/icons.pug
include ../components/apptabs.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Portfolio
          p.app-sub Tier #{tier} · #{assetCount} assets across #{networkCount} networks
        +appTabs("overview")

      .app-block
        .pf
          .pf-value
            .pf-label Total value, USD
            .pf-amount
              +amount(total)
              if !pricesUnavailable
                span.pf-delta.flat 0.00% today
            if pricesUnavailable
              p.app-sub Price data unavailable. Balances below are accurate.
            else
              p.app-sub Valued at indicative market prices.
          .pf-actions
            a.btn(href="/wallet/deposit") Deposit
            a.btn(href="/wallet/withdraw") Withdraw
            button.btn(type="button" disabled title=actionReason) Trade

      .app-block
        .tiles
          .tile
            .tile-label Available
            .tile-value.num= availableTotal
            .tile-note Free to trade or withdraw
          .tile
            .tile-label On hold
            .tile-value.num= heldTotal
            .tile-note Reserved by pending activity
          .tile
            .tile-label Verification
            .tile-value Tier #{tier}
            .tile-note= tierNote
          .tile
            .tile-label Withdrawal limit
            .tile-value.num= withdrawalLimit
            .tile-note Per day at this tier

      .app-block
        .panel-table
          .panel-table-head
            h2 Balances
            span.app-sub #{assetCount} assets
          if empty
            .empty-note
              p No balances yet. Deposit an asset to get started.
              a.btn(href="/account/verification") Check your verification
          .table-scroll
            table.table
              thead
                tr
                  th Asset
                  th Network
                  th.n Available
                  th.n On hold
                  th.n Value (USD)
                  th.n Allocation
              tbody
                each row in balances
                  tr
                    td
                      .asset-name
                        strong= row.name
                        span.asset-ticker= row.displaySymbol
                    td: span.network-tag= row.networkLabel
                    td.n
                      if row.hasBalance
                        +amount(row.available)
                      else
                        span.num.zero= row.available.whole + "." + row.available.fraction
                    td.n
                      if row.hasHold
                        +amount(row.held)
                      else
                        span.num.zero 0
                    td.n
                      if row.value
                        +amount(row.value)
                      else
                        span.num.zero unpriced
                    td.n
                      .alloc
                        .alloc-bar
                          span.alloc-fill(class=row.allocClass)
                        span.alloc-pct= row.allocLabel

      .app-block
        p.app-sub= actionReason
