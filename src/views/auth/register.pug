extends ../layouts/base.pug
include ../components/icons.pug

block content
  .shell
    .auth
      .auth-card
        .auth-mark
          +icon("mark", 26)
        h1 Create your account.
        p.lead Create an account to deposit, hold, and transfer digital assets.
        if error
          p.form-error= error
        form(method="post" action="/register")
          input(type="hidden" name="_csrf" value=csrfToken)
          .field
            label(for="email") Email address
            input#email(type="email" name="email" value=email required autocomplete="email")
          .field
            label(for="password") Password
            input#password(type="password" name="password" required autocomplete="new-password" minlength="12")
            p.field-hint Minimum 12 characters. Checked against known breach databases.
          button.btn.btn-primary(type="submit") Create account
        p.auth-foot
          | Already have an account?
          |  
          a(href="/login") Sign in
