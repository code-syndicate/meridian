extends ../layouts/base.pug
include ../components/icons.pug

block content
  .shell
    .auth
      .auth-card
        .auth-mark
          +icon("mark", 26)
        h1 Check your email.
        p.lead If that address does not already have an account, we have sent it a confirmation link. It works once and expires in 24 hours.
        p.auth-foot No email? Check your spam folder or register again.
