mixin icon(name, size)
  - var s = size || 18
  if name === "mark"
    svg(width=s height=s viewBox="0 0 16 16" fill="none" aria-hidden="true")
      path(d="M8 1 14.5 5v6L8 15 1.5 11V5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round")
      path(d="M8 5.5 11 7.3v3.4L8 12.5 5 10.7V7.3z" fill="currentColor" opacity=".55")
  else if name === "vault"
    svg(width=s height=s viewBox="0 0 20 20" fill="none" aria-hidden="true")
      rect(x="2.5" y="3.5" width="15" height="13" rx="2" stroke="currentColor" stroke-width="1.3")
      circle(cx="10" cy="10" r="3.2" stroke="currentColor" stroke-width="1.3")
      path(d="M10 5.4v1.4M10 13.2v1.4M14.6 10h-1.4M6.8 10H5.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round")
  else if name === "ledger"
    svg(width=s height=s viewBox="0 0 20 20" fill="none" aria-hidden="true")
      path(d="M4.5 3.5h11v13h-11z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round")
      path(d="M7.5 7.5h5M7.5 10h5M7.5 12.5h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round")
  else if name === "key"
    svg(width=s height=s viewBox="0 0 20 20" fill="none" aria-hidden="true")
      circle(cx="7" cy="10" r="3.3" stroke="currentColor" stroke-width="1.3")
      path(d="M10.3 10h6.2M14 10v2.4M16.5 10v1.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round")
  else if name === "arrow"
    svg(width=s height=s viewBox="0 0 16 16" fill="none" aria-hidden="true")
      path(d="M3.5 8h9M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round")
