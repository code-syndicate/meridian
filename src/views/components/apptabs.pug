mixin appTabs(current)
  nav.app-tabs(aria-label="Account")
    a(href="/dashboard" aria-current=(current === "overview" ? "page" : false)) Overview
    a(href="/wallet/deposit" aria-current=(current === "deposit" ? "page" : false)) Deposit
    a(href="/wallet/withdraw" aria-current=(current === "withdraw" ? "page" : false)) Withdraw
    a(href="/wallet/send" aria-current=(current === "send" ? "page" : false)) Send
    a(href="/wallet/transactions" aria-current=(current === "transactions" ? "page" : false)) Transactions
    a(href="/account" aria-current=(current === "account" ? "page" : false)) Account
    a(href="/account/verification" aria-current=(current === "verification" ? "page" : false)) Verification
    a(href="/account/security" aria-current=(current === "security" ? "page" : false)) Security
