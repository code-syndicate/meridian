mixin ticker()
  .ticker(x-data="ticker" role="region" aria-label="Indicative prices")
    .shell.ticker-inner
      template(x-for="row in rows")
        .ticker-item
          span.ticker-sym(x-text="row.symbol")
          span.ticker-px(x-text="row.price" x-bind:class="row.flash")
          span.ticker-ch(x-text="row.change" x-bind:class="row.direction")
      template(x-if="rows.length === 0")
        .ticker-skeletons(role="status")
          span.visually-hidden Loading indicative prices
          each width in [58, 62, 54, 60, 56, 64]
            span.skeleton(class="skel-" + width)
