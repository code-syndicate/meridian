extends ../layouts/base.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Security
          p.app-sub Password, two-factor authentication, and where you are signed in
        nav.app-tabs(aria-label="Account")
          a(href="/dashboard") Overview
          a(href="/account/verification") Verification
          a(href="/account/security" aria-current="page") Security
          a(href="/account/activity") Activity
      if error
        p.form-error= error

      .app-block
        .form-card
          h2 Password
      form(method="post" action="/account/password")
        input(type="hidden" name="_csrf" value=csrfToken)
        .field
          label(for="current") Current password
          input#current(type="password" name="current" required autocomplete="current-password")
        .field
          label(for="next") New password
          input#next(type="password" name="next" required autocomplete="new-password" minlength="8")
          p.field-hint At least 8 characters, with one letter and one number.
        button.btn(type="submit") Change password
      p.field-hint Changing your password signs you out everywhere else.

      .app-block
        .form-card
          h2 Two-factor authentication
      if totpEnabled
        p Two-factor authentication is on. Every withdrawal requires a code from your authenticator app.
        form(method="post" action="/account/2fa/disable")
          input(type="hidden" name="_csrf" value=csrfToken)
          button.btn(type="submit") Turn off
      else
        p Two-factor authentication is off. Withdrawals still work, but anyone with your password can move your funds.
        a.btn.btn-primary(href="/account/2fa") Turn on

      .app-block
        .panel-table
          .panel-table-head
            h2 Where you are signed in
      .table-scroll
        table.table
          thead
            tr
              th Device
              th IP address
              th Last active
          tbody
            each session in sessions
              tr
                td
                  = session.label
                  if session.current
                    |  (this device)
                td.num= session.ip
                td.num= session.lastSeen
      form(method="post" action="/account/sessions/revoke-others")
        input(type="hidden" name="_csrf" value=csrfToken)
        button.btn(type="submit") Sign out of other devices
