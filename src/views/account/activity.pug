extends ../layouts/base.pug

block content
  .shell
    .app
      .app-head
        div
          h1.app-title Activity
          p.app-sub Every sign in and security change on your account
        nav.app-tabs(aria-label="Account")
          a(href="/dashboard") Overview
          a(href="/account/verification") Verification
          a(href="/account/security") Security
          a(href="/account/activity" aria-current="page") Activity
      p.app-sub If something here was not you, change your password and turn on two-factor authentication.
      .table-scroll
        table.table
          thead
            tr
              th Event
              th IP address
              th When
          tbody
            each entry in entries
              tr
                td= entry.label
                td.num= entry.ip
                td.num= entry.at
