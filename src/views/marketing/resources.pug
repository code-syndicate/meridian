extends ../layouts/base.pug
include ../components/news.pug

block content
  .shell
    .section
      .section-head
        .eyebrow Resources
        h1 Learn and resources
        p Guides, policies, and fee information for Meridian.
      .card-grid
        each item in resources
          a.res-card(href=item.href)
            span.res-kicker= item.kicker
            h2.res-title= item.title
            p= item.body

    if news && news.length
      .section.section-line
        .section-head
          .eyebrow Market news
          h2 Crypto news
          p Headlines from third-party sources. Not written or endorsed by Meridian. Not investment advice.
        +newsList(news)
