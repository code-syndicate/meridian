extends ../layouts/base.pug

block content
  .shell
    .docs-head
      .eyebrow Help centre
      h1 Help centre
      p.lead Guides on deposits, networks, verification, and account security.

    .section-tight
      each group in groups
        .app-block
          .docs-nav-label= group.category
          .card-grid
            each article in group.articles
              a.res-card(href="/help/" + article.slug)
                h2.res-title= article.title
                p= article.summary

    .docs-foot
      .docs-foot-label Next
      .card-grid
        a.res-card(href="/get-started")
          span.res-kicker Start here
          h2.res-title Get started
          p Account setup through identity verification.
        a.res-card(href="/fees")
          span.res-kicker Costs
          h2.res-title Fee schedule
          p Deposit, withdrawal, and trading fees.
