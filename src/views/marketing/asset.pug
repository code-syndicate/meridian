extends ../layouts/base.pug
include ../components/amount.pug
include ../components/spark.pug

block content
  .shell
    .asset-head
      div
        .eyebrow= asset.networkLabel
        h1 #{asset.name} (#{asset.displaySymbol})
      .asset-price
        if price
          +amount(price)
        else
          span.num unavailable
        span.num(class=direction)= change
    p.app-sub Indicative price from public market data. Reference only, not a quote.

    .app-block
      dl.asset-facts
        .asset-fact
          dt Network
          dd= asset.networkLabel
        .asset-fact
          dt Confirmations
          dd #{asset.confirmationsRequired} required
        .asset-fact
          dt Deposits
          dd= asset.depositEnabled ? "Enabled" : "Disabled"
        .asset-fact
          dt Withdrawals
          dd= asset.withdrawalEnabled ? "Enabled" : "Disabled"
        .asset-fact
          dt Trading
          dd= asset.tradingEnabled ? "Enabled" : "Disabled"
        if asset.contractAddress
          .asset-fact
            dt Contract address
            dd= asset.contractAddress

    if asset.kind === "token"
      .app-block
        .warn-note
          h2 Network matters
          p #{asset.displaySymbol} exists on more than one network. Sending #{asset.displaySymbol} to a #{asset.networkLabel} address over any other network results in permanent loss and cannot be reversed. Verify the network before sending.

    .docs-foot
      .docs-foot-label Elsewhere
      .card-grid
        a.res-card(href="/markets")
          span.res-kicker Markets
          h2.res-title All supported assets
          p Every asset and network we support, with live indicative prices.
        a.res-card(href="/help/choosing-the-right-network")
          span.res-kicker Guide
          h2.res-title Choosing the right network
          p The mistake that costs people the most money, and how to avoid it.
