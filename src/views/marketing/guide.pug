extends ../layouts/base.pug
include ../components/icons.pug

block content
  .shell
    .section
      .section-head
        .eyebrow Get started
        h1 How to get started on Meridian
        p Account setup through identity verification. Each step can be resumed.
      ol.steps-list
        each step, index in steps
          li.step-card
            .step-num= index + 1
            div
              h2.step-title= step.title
              p= step.body
      .actions
        a.btn.btn-primary.btn-lg(href="/register")
          | Open an account
          +icon("arrow", 16)
        a.btn.btn-lg(href="/resources") Browse resources

    .section.section-line
      .section-head
        .eyebrow Before you start
        h2 Before you deposit
      .grid-3
        .feature
          .feature-icon
            +icon("key", 18)
          h3 Networks are not interchangeable
          p The same ticker can exist on several networks. Sending over the wrong network results in permanent loss.
        .feature
          .feature-icon
            +icon("vault", 18)
          h3 We hold your assets, pooled
          p Your balance is tracked in the Meridian ledger, not a wallet you control. This is standard for centralized exchanges.
        .feature
          .feature-icon
            +icon("ledger", 18)
          h3 Nothing is live yet
          p Accounts and verification are open. Trading opens on registration.
