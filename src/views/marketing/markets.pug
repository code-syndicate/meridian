extends ../layouts/base.pug
include ../components/amount.pug
include ../components/spark.pug

block content
  .shell
    .section
      .section-head
        .eyebrow Markets
        h1 Cryptocurrency prices by market cap
        p Prices are indicative, sourced from public market data, and refresh every ten seconds. They are for reference only and do not price any transaction.
      .table-scroll
        table.table
          thead
            tr
              th Asset
              th Network
              th.n Price
              th.n 24h %
              th.n Market cap
              th.n Volume (24h)
              th 7d chart
              th.n Confirmations
          tbody
            each row in rows
              tr
                td
                  .asset-name
                    strong= row.name
                    span.asset-ticker= row.displaySymbol
                td: span.network-tag= row.networkLabel
                td.n
                  if row.price
                    +amount(row.price)
                  else
                    span.num -
                td.n.num(class=row.direction)= row.change
                td.n.num= row.marketCap
                td.n.num= row.volume24h
                td.spark-cell
                  +sparkline(row.spark, row.displaySymbol + " price over the last week")
                td.n.num= row.confirmations
