extends ../layouts/base.pug
include ../components/amount.pug
include ../components/spark.pug
include ../components/icons.pug
include ../components/news.pug
include ../components/movers.pug

block content
  .shell
    .hero
      .hero-glow(aria-hidden="true")
      .hero-grid
        div
          if user
            h1
              | Welcome back to 
              span.headline-accent Meridian Exchanger.
            p.lead Your portfolio, deposits, and transfers are in one place. Prices below are indicative and refresh every ten seconds.
            .actions
              a.btn.btn-primary.btn-lg(href="/dashboard")
                | Go to your portfolio
                +icon("arrow", 16)
              a.btn.btn-lg(href="/wallet/deposit") Deposit
              a.btn.btn-lg(href="/wallet/send") Send
          else
            h1
              | Buy, sell, and store 
              span.headline-accent digital assets.
            p.lead Ten assets across five networks. Third-party custody, published fees, and instant transfers between Meridian accounts.
            form.hero-signup(method="get" action="/register")
              label.visually-hidden(for="hero-email") Email address
              input#hero-email(type="email" name="email" placeholder="Email address" autocomplete="email")
              button.btn.btn-primary.btn-lg(type="submit")
                | Get started
                +icon("arrow", 16)
            p.hero-alt
              | Already have an account? 
              a(href="/login") Sign in
        .preview.reveal(x-data="reveal")
          .preview-bar
            .preview-dots
              i
              i
              i
            span.preview-title= preview.mine ? "YOUR PORTFOLIO" : "PORTFOLIO"
          .preview-body
            .preview-total-label Total value, USD
            .preview-total.num
              = preview.total.whole
              span.num-frac .#{preview.total.fraction}
            .preview-delta(class=preview.direction)= preview.change + " today"
            if preview.spark
              .preview-chart
                +sparkline(preview.spark, "Portfolio value over the last week")
            if preview.mine && preview.empty
              .preview-empty
                p You have no assets yet.
                a.btn(href="/wallet/deposit") Make a deposit
            else
              .preview-rows
                each row in preview.rows
                  .preview-row
                    .who
                      strong= row.name
                      span.sym= row.symbol
                    span.amt= row.amount
                    span.val= row.value

    .section.section-line
      .section-head
        .eyebrow Markets
        h2 Cryptocurrency prices today
        p Indicative prices from public market data, updated every 10 seconds.
      .table-scroll
        table.table
          thead
            tr
              th Asset
              th Network
              th.n Price (USD)
              th.n 24h
              th 7 days
          tbody
            each row in strip
              tr(data-strip-row)
                td
                  .asset-name
                    strong= row.name
                    span.asset-ticker= row.displaySymbol
                td: span.network-tag= row.networkLabel
                td.n
                  +amount(row.price)
                td.n.num(class=row.direction)= row.change
                td.spark-cell
                  +sparkline(row.spark, row.displaySymbol + " price over the last week")
      p.field-hint
        a(href="/markets") See all cryptocurrency prices

    if gainers && gainers.length
      .section.section-line
        .section-head
          .eyebrow Movers
          h2 Top gainers and losers
          p Largest 24 hour price moves across supported assets.
        +movers(gainers, losers)

    .section.section-line
      .section-head
        .eyebrow How custody works
        h2 How custody works
        p Client assets are pooled. Balances are tracked in an internal double-entry ledger and reconciled continuously.
      .grid-3
        .feature
          .feature-icon
            +icon("vault", 18)
          h3 Pooled reserves
          p Client assets are held in pooled wallets. Your balance is tracked separately in our ledger and reconciled against reserves continuously.
        .feature
          .feature-icon
            +icon("ledger", 18)
          h3 An append-only ledger
          p Ledger records cannot be edited or deleted. Corrections are posted as new entries. Enforced at the database level.
        .feature
          .feature-icon
            +icon("key", 18)
          h3 Third-party custody
          p Private keys are held by a licensed custody provider under multi-party controls. No single employee can move client assets.

    .section.section-line
      .stats
        .stat
          .stat-label Deposit fee
          .stat-value 0.00%
        .stat
          .stat-label Assets supported
          .stat-value 10
        .stat
          .stat-label Networks
          .stat-value 5

    if news && news.length
      .section.section-line
        .section-head
          .eyebrow Market news
          h2 Crypto news
          p Headlines from third-party sources. Not investment advice.
        +newsList(news)
        p.field-hint
          a(href="/resources") More resources and reading

    .section-tight
      .section-head
        .eyebrow Fees
        h2 Fees
        p Free deposits. Withdrawals cost the network fee plus a fixed amount per asset. Trading spread shown before you confirm.
      .actions
        a.btn(href="/fees")
          | See the fee schedule
          +icon("arrow", 15)

    .section.section-line
      .section-head
        .eyebrow Compliance
        h2 Regulatory and compliance
        p Identity verification, sanctions and politically exposed person screening, and transaction monitoring run on every account. Government identifiers are never stored in full.
      .actions
        a.btn(href="/regulatory")
          | Read the detail
          +icon("arrow", 15)
