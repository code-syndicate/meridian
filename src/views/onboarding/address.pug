extends ../layouts/base.pug
include ../components/step-rail.pug

block content
  .shell
    .wizard
      +stepRail(stepNumber, stepTotal)
      h1 Where you live.
      p.lead Your residential address. A post office box is not accepted.
      form(method="post" action="/onboarding/address")
        input(type="hidden" name="_csrf" value=csrfToken)
        .field
          label(for="country") Country
          select#country(name="country" required)
            option(value="") Choose a country
            each c in countries
              option(value=c.code selected=(values.country === c.code))= c.name
          if errors.country
            p.field-error= errors.country
        .field
          label(for="region") State, province, or region
          input#region(type="text" name="region" value=values.region required autocomplete="address-level1")
          if errors.region
            p.field-error= errors.region
        .field
          label(for="city") City or town
          input#city(type="text" name="city" value=values.city required autocomplete="address-level2")
          if errors.city
            p.field-error= errors.city
        .field
          label(for="streetAddress") Street address
          input#streetAddress(type="text" name="streetAddress" value=values.streetAddress required autocomplete="street-address")
          if errors.streetAddress
            p.field-error= errors.streetAddress
        .field
          label(for="postalCode") Postal or ZIP code (optional)
          input#postalCode(type="text" name="postalCode" value=values.postalCode autocomplete="postal-code")
        button.btn.btn-primary(type="submit") Continue
