extends ../layouts/base.pug

block content
  .shell
    .wizard
      .eyebrow Verification
      h1 Your application is with our reviewers.
      p We have everything we need. You will get an email when there is a decision.
      p We are not going to give you an estimated time, because we do not have a measured one yet and a made up number helps nobody.
      .actions
        a.btn(href="/account/verification") Check status
        a.btn(href="/dashboard") Go to dashboard
