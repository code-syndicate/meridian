extends ../layouts/base.pug
include ../components/step-rail.pug

block content
  .shell
    .wizard
      +stepRail(stepNumber, stepTotal)
      h1 Your identity document.
      p.lead We send these details to our verification provider to confirm they match the name and date of birth you gave. We keep the last four characters and the provider reference, never the full number.
      if last4
        p.field-hint Currently verified ending #{last4}.
      form(method="post" action="/onboarding/government-id")
        input(type="hidden" name="_csrf" value=csrfToken)
        fieldset.field
          legend Document type
          .radio
            input#typePassport(type="radio" name="idType" value="PASSPORT" checked=(idType === "PASSPORT"))
            label(for="typePassport") Passport
          .radio
            input#typeNational(type="radio" name="idType" value="NATIONAL_ID" checked=(idType === "NATIONAL_ID"))
            label(for="typeNational") National ID card
          .radio
            input#typeLicense(type="radio" name="idType" value="DRIVERS_LICENSE" checked=(idType === "DRIVERS_LICENSE"))
            label(for="typeLicense") Driver's licence
        .field
          label(for="idNumber") Document number
          input#idNumber(type="text" name="idNumber" required autocomplete="off" spellcheck="false")
          p.field-hint As printed on the document, without spaces.
          if errors.governmentId
            p.field-error= errors.governmentId
        button.btn.btn-primary(type="submit") Verify
