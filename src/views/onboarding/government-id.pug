extends ../layouts/base.pug
include ../components/step-rail.pug

block content
  .shell
    .wizard
      +stepRail(stepNumber, stepTotal)
      h1 Your BVN or NIN.
      p We send this to our verification provider to confirm it matches the name and date of birth you gave. We keep the last four digits and the provider's reference, never the full number.
      if last4
        p.field-hint Currently verified ending #{last4}.
      form(method="post" action="/onboarding/government-id")
        input(type="hidden" name="_csrf" value=csrfToken)
        fieldset.field
          legend Identifier type
          .radio
            input#typeBvn(type="radio" name="idType" value="BVN" checked=(idType === "BVN"))
            label(for="typeBvn") BVN
          .radio
            input#typeNin(type="radio" name="idType" value="NIN" checked=(idType === "NIN"))
            label(for="typeNin") NIN
        .field
          label(for="idNumber") Identifier number
          input#idNumber(type="text" name="idNumber" required inputmode="numeric" autocomplete="off")
          p.field-hint 11 digits.
          if errors.governmentId
            p.field-error= errors.governmentId
        button.btn.btn-primary(type="submit") Verify
