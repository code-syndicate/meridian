NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/meridian.db
SESSION_SECRET=change-me-to-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=change-me-to-at-least-32-random-characters

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Meridian Exchanger <no-reply@meridianexchanger.com>

KYC_PROVIDER=sandbox

CUSTODY_PROVIDER=sandbox

# Value an account may move out before verifying, and the daily ceilings after.
FREE_TIER_LIMIT_USD=10000
TIER1_DAILY_LIMIT_USD=10000
TIER2_DAILY_LIMIT_USD=100000

# Demonstration custody. Derives real, verifiable addresses from a seed phrase
# we hold, so a stakeholder can check one in any wallet. Movement is still
# simulated, and production refuses this provider.
# Generate with: bun run new-mnemonic
# CUSTODY_PROVIDER=hd
# CUSTODY_MNEMONIC="..."
